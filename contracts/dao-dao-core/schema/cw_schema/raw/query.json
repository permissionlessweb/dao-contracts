          "description": "Returns the actions executed by the DAO on instantiation, if any.",
          "type": "named",
          "properties": {}
        },
        "list_items": {
          "description": "Lists all of the items associted with the contract. For\nexample, given the items `{ \"group\": \"foo\", \"subdao\": \"bar\"}`\nthis query would return `[(\"group\", \"foo\"), (\"subdao\",\n\"bar\")]`.",
