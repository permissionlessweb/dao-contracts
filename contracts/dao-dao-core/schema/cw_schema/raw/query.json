          "properties": {
            "limit": {
              "value": 4
            },
            "start_after": {
              "value": 2
            }
          }
        },
        "list_sub_daos": {
          "description": "Returns all SubDAOs with their charters in a vec.\nstart_after is bound exclusive and asks for a string address.",
